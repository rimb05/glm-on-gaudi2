# Site settings: everything that belongs to one installation and not to the method.
# Copy this file to deploy/site.env and fill it in. deploy/site.env is not tracked by git.
#
# Who reads it (as bash): deploy/serve_node.sh and the ad-hoc launchers on the servers, and the bin/ scripts on
# the workstation. bin/sync_code.sh copies it to both servers together with the rest of deploy/.
# One KEY=VALUE per line, no spaces around "=".

# --- how the workstation reaches the two servers (anything `ssh` accepts as a destination).
# Node 0 runs pipeline stage 0 and the API; node 1 runs stage 1. The account must be able to run
# `sudo -n docker` on the servers. For anything more elaborate (a jump host, a wrapper script) define a shell
# function instead:   node_ssh() { local n=$1; shift; my-wrapper "$n" "$@"; }
NODE0_SSH=admin@node0.example
NODE1_SSH=admin@node1.example

# --- the link between the servers
# FABRIC_IF: the network interface of one Gaudi scale-out port that has an IPv4 address and reaches the other
# server through the switch (the same interface name on both servers). The stage rendezvous, the prefill link
# (TCP) and the pair watchdog use it. The card-to-card collectives use all scale-out ports by themselves.
FABRIC_IF=enp1s0d1
# the servers' addresses on that interface
NODE0_ADDR=10.10.0.1
NODE1_ADDR=10.10.0.2
# HCCL_IF: an ordinary host interface for HCCL's own TCP control connections (HCCL_SOCKET_IFNAME), the same name
# on both servers
HCCL_IF=eth0

# --- optional: replace values of the active profile (deploy/glm53.env)
#MODEL=/workspace/glm53/models/GLM-5.3-FP8
#SERVED_NAME=glm-5.3
# The API listens on node 0's loopback unless this says otherwise; only private addresses are accepted.
#API_HOST=127.0.0.1
#API_KEY=
