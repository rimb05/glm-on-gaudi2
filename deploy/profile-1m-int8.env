# GLM-5.3 on two Gaudi 2 servers, profile "1M, 8-bit KV cache": 1,047,000-token window. The latent KV cache holds
# 8-bit codes (one scale per token and 64 dimensions; error about 0.6 % per latent), which is what makes 1M tokens fit.
# To use it: copy this file over deploy/glm53.env, run bin/sync_code.sh, restart both units.
# One KEY=VALUE per line, no quotes, no spaces around "=". Lines starting with # are comments.
# Values that belong to the installation (interfaces, addresses, model path) are in deploy/site.env.

# --- what is served
MODEL=/workspace/glm53/models/GLM-5.3-FP8
SERVED_NAME=glm-5.3
IMAGE=glm53-serve:dev1
# container name on both servers
NAME=glm53-serve

# --- layout: pipeline of 2 stages (node 0 = layers 0-41 + API, node 1 = layers 42-77 + LM head + MTP layer),
# 8 cards per stage with tensor + expert parallelism. The split must start on a full-indexer layer.
PARTITION=42,36
TP=8
# rendezvous port on node 0 (the addresses are in deploy/site.env)
MASTER_PORT=29555

# --- context: 8184 blocks of 128 tokens = 1,047,552 tokens of KV pool; requests up to 1,047,000 tokens
MAX_MODEL_LEN=1047000
KV_BLOCKS=8184
BUCKETS=/workspace/glm53/serving/buckets-1m-c4096.txt
MAX_SEQS=4
# latent KV cache: empty = bf16 as the model computes it; int8 = 8-bit codes (see profile-1m-int8.env)
KV_CODEC=int8
# decode attends through the indexer (top 2048 keys) from this many cached tokens on, to everything below
SPARSE_DECODE_FROM=4096

# --- API: loopback on node 0 only (reach it through an SSH forward). To serve a private network instead, set
# API_HOST to node 0's address on it and API_KEY to a secret in deploy/site.env; a public address is refused.
API_HOST=127.0.0.1
API_PORT=8000
API_KEY=

# --- speculative decoding: draft tokens per step from the model's own MTP layer
MTP=2
